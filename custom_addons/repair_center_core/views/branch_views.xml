<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_center_branch_list" model="ir.ui.view">
        <field name="name">repair.center.branch.list</field>
        <field name="model">repair.center.branch</field>
        <field name="arch" type="xml">
            <list string="Service Branches" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="phone"/>
                <field name="email" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_repair_center_branch_form" model="ir.ui.view">
        <field name="name">repair.center.branch.form</field>
        <field name="model">repair.center.branch</field>
        <field name="arch" type="xml">
            <form string="Service Branch">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Damascus Main Branch"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Location">
                        <field name="address" nolabel="1" placeholder="Full branch address..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_repair_center_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">repair.center.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
