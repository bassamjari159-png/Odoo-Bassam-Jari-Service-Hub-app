<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_repair_branding" model="ir.ui.view">
        <field name="name">res.company.form.repair.branding</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Service Hub Identity" name="service_hub_identity">
                    <group>
                        <group string="Brand Identity">
                            <field name="repair_brand_name"/>
                            <field name="repair_owner_name"/>
                            <field name="repair_tagline"/>
                        </group>
                        <group string="Customer Support">
                            <field name="repair_support_phone" widget="phone"/>
                            <field name="repair_support_email" widget="email"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        These values appear in the BASSAM JARI Service Hub dashboard and customer-facing documents.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
