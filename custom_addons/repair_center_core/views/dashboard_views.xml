<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dashboard_main" model="repair.center.dashboard">
        <field name="name">Company Overview</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <record id="view_repair_center_dashboard_form" model="ir.ui.view">
        <field name="name">repair.center.dashboard.form</field>
        <field name="model">repair.center.dashboard</field>
        <field name="arch" type="xml">
            <form string="Service Company Dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <div class="text-center py-4">
                        <h1 class="display-5 fw-bold text-primary">
                            <field name="brand_name" nolabel="1"/>
                        </h1>
                        <h3 class="text-muted mb-2">
                            <field name="owner_name" nolabel="1"/>
                        </h3>
                        <p class="lead">
                            <field name="tagline" nolabel="1"/>
                        </p>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-lg-3 col-md-6">
                            <button name="action_all_orders" type="object" class="btn btn-light border rounded-3 w-100 p-4 text-start">
                                <span class="text-muted">All Repair Orders</span>
                                <div class="fs-2 fw-bold text-primary"><field name="total_orders"/></div>
                            </button>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <button name="action_active_orders" type="object" class="btn btn-light border rounded-3 w-100 p-4 text-start">
                                <span class="text-muted">Active Repairs</span>
                                <div class="fs-2 fw-bold text-warning"><field name="active_orders"/></div>
                            </button>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <button name="action_ready_orders" type="object" class="btn btn-light border rounded-3 w-100 p-4 text-start">
                                <span class="text-muted">Ready for Delivery</span>
                                <div class="fs-2 fw-bold text-success"><field name="ready_orders"/></div>
                            </button>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <button name="action_delivered_orders" type="object" class="btn btn-light border rounded-3 w-100 p-4 text-start">
                                <span class="text-muted">Delivered</span>
                                <div class="fs-2 fw-bold"><field name="delivered_orders"/></div>
                            </button>
                        </div>
                    </div>

                    <group string="Company Intelligence" col="4">
                        <group>
                            <field name="total_customers"/>
                            <field name="total_devices"/>
                        </group>
                        <group>
                            <field name="total_revenue_syp" widget="monetary"/>
                            <field name="outstanding_amount_syp" widget="monetary"/>
                        </group>
                        <group>
                            <field name="total_revenue_usd" widget="monetary"/>
                            <field name="outstanding_amount_usd" widget="monetary"/>
                        </group>
                    </group>

                    <div class="alert alert-info mt-4" role="alert">
                        This dashboard is your command center. Open any metric to see the matching repair orders.
                    </div>
                    <field name="company_id" invisible="1"/>
                    <field name="syp_currency_id" invisible="1"/>
                    <field name="usd_currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_repair_center_dashboard" model="ir.actions.act_window">
        <field name="name">Company Dashboard</field>
        <field name="res_model">repair.center.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_repair_center_dashboard_form"/>
        <field name="res_id" ref="dashboard_main"/>
        <field name="target">current</field>
    </record>
</odoo>
