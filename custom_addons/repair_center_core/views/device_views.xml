<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_center_device_list" model="ir.ui.view">
        <field name="name">repair.center.device.list</field>
        <field name="model">repair.center.device</field>
        <field name="arch" type="xml">
            <list string="Customer Devices" decoration-muted="not active">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="device_type"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="imei" optional="hide"/>
                <field name="repair_count" string="Repairs"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_repair_center_device_form" model="ir.ui.view">
        <field name="name">repair.center.device.form</field>
        <field name="model">repair.center.device</field>
        <field name="arch" type="xml">
            <form string="Customer Device">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_repairs" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="repair_count" widget="statinfo" string="Repairs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Bassam's iPhone"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="device_type"/>
                            <field name="brand"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="serial_number"/>
                            <field name="imei"/>
                            <field name="color"/>
                            <field name="purchase_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Device Notes">
                            <field name="notes" placeholder="Device history, passwords excluded, and special observations..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_repair_center_device_search" model="ir.ui.view">
        <field name="name">repair.center.device.search</field>
        <field name="model">repair.center.device</field>
        <field name="arch" type="xml">
            <search string="Customer Devices">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="imei"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="group_type" string="Device Type" context="{'group_by': 'device_type'}"/>
                    <filter name="group_brand" string="Brand" context="{'group_by': 'brand'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_repair_center_device" model="ir.actions.act_window">
        <field name="name">Customer Devices</field>
        <field name="res_model">repair.center.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_repair_center_device_search"/>
    </record>
</odoo>
