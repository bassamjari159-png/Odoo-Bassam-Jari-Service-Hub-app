<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_center_service_list" model="ir.ui.view">
        <field name="name">repair.center.service.list</field>
        <field name="model">repair.center.service</field>
        <field name="arch" type="xml">
            <list string="Service Catalog" editable="bottom" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="service_type"/>
                <field name="list_price" widget="monetary"/>
                <field name="standard_cost" widget="monetary" optional="hide"/>
                <field name="currency_id"/>
                <field name="expected_hours"/>
                <field name="warranty_days"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_repair_center_service_form" model="ir.ui.view">
        <field name="name">repair.center.service.form</field>
        <field name="model">repair.center.service</field>
        <field name="arch" type="xml">
            <form string="Service Catalog Item">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Screen Replacement"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="service_type"/>
                            <field name="expected_hours"/>
                            <field name="warranty_days"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="standard_cost"/>
                            <field name="currency_id" options="{'no_create': True, 'no_open': True}" domain="[('name', 'in', ['SYP', 'USD'])]"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_repair_center_service" model="ir.actions.act_window">
        <field name="name">Service Catalog</field>
        <field name="res_model">repair.center.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
