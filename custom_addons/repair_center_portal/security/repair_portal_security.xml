<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="repair_center_order_rule_portal" model="ir.rule">
        <field name="name">Portal: own repair orders only</field>
        <field name="model_id" ref="repair_center_core.model_repair_center_order"/>
        <field name="domain_force">[('customer_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="repair_center_order_line_rule_portal" model="ir.rule">
        <field name="name">Portal: lines of own repair orders only</field>
        <field name="model_id" ref="repair_center_core.model_repair_center_order_line"/>
        <field name="domain_force">[('order_id.customer_id', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
