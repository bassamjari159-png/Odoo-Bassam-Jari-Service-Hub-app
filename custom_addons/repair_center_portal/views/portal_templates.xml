<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_repair" name="Repair Orders" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Repair Orders</t>
                <t t-set="url" t-value="'/my/repairs'"/>
                <t t-set="text">Track the diagnosis and repair status of your devices</t>
                <t t-set="placeholder_count" t-value="'repair_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_repairs" name="My Repair Orders">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Repair Orders</t>
            </t>

            <div class="p-4 mb-4 rounded-3 bg-primary text-white shadow-sm">
                <h2 class="mb-1" t-out="request.env.company.repair_brand_name"/>
                <p class="mb-0 opacity-75">Live repair tracking powered by Engineer BASSAM JARI</p>
            </div>

            <div t-if="not repairs" class="alert alert-warning" role="alert">
                There are currently no repair orders for your account.
            </div>

            <t t-if="repairs" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Device</th>
                        <th>Received On</th>
                        <th>Expected Completion</th>
                        <th class="text-end">Amount Due</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <t t-foreach="repairs" t-as="repair">
                    <tr>
                        <td>
                            <a t-att-href="'/my/repairs/%s' % repair.id" class="fw-bold">
                                <t t-out="repair.name"/>
                            </a>
                        </td>
                        <td><span t-field="repair.device_name"/></td>
                        <td><span t-field="repair.date_received" t-options="{'widget': 'date'}"/></td>
                        <td>
                            <span t-if="repair.estimated_completion" t-field="repair.estimated_completion" t-options="{'widget': 'date'}"/>
                            <span t-else="">-</span>
                        </td>
                        <td class="text-end"><span t-field="repair.amount_due"/></td>
                        <td class="text-end"><span class="badge rounded-pill text-bg-primary" t-field="repair.state"/></td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <template id="portal_my_repair" name="Repair Order Details">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <a href="/my/repairs" class="btn btn-link px-0 mb-3">
                    <i class="fa fa-arrow-left me-1"/> Back to Repair Orders
                </a>

                <div class="p-4 mb-4 rounded-3 bg-primary text-white shadow-sm">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="small opacity-75" t-out="repair.company_id.repair_brand_name"/>
                            <h2 class="mb-1" t-out="repair.name"/>
                            <p class="mb-0" t-out="repair.device_name"/>
                        </div>
                        <span class="badge rounded-pill bg-light text-primary fs-6" t-field="repair.state"/>
                    </div>
                </div>

                <t t-set="progress" t-value="{'new': 10, 'diagnosis': 25, 'approved': 45, 'in_progress': 70, 'done': 90, 'delivered': 100, 'cancelled': 0}.get(repair.state, 0)"/>
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <strong>Repair Progress</strong>
                            <span><t t-out="progress"/>%</span>
                        </div>
                        <div class="progress" style="height: 12px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" t-att-style="'width: ' + str(progress) + '%'"/>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header fw-bold">Device and Schedule</div>
                    <div class="card-body">
                        <div class="row g-4">
                            <div class="col-md-4"><h6 class="text-muted">Device</h6><p class="mb-0" t-field="repair.device_name"/></div>
                            <div class="col-md-4"><h6 class="text-muted">Serial Number</h6><p class="mb-0" t-out="repair.device_serial or '-'"/></div>
                            <div class="col-md-4"><h6 class="text-muted">Branch</h6><p class="mb-0" t-out="repair.branch_id.name or '-'"/></div>
                            <div class="col-md-4"><h6 class="text-muted">Received On</h6><p class="mb-0" t-field="repair.date_received"/></div>
                            <div class="col-md-4"><h6 class="text-muted">Expected Completion</h6><p class="mb-0" t-out="repair.estimated_completion or '-'"/></div>
                            <div class="col-md-4"><h6 class="text-muted">Technician</h6><p class="mb-0" t-out="repair.technician_id.name or '-'"/></div>
                            <div class="col-12"><h6 class="text-muted">Reported Issue</h6><p class="mb-0" t-field="repair.issue_description"/></div>
                        </div>
                    </div>
                </div>

                <div t-if="repair.line_ids" class="card shadow-sm mb-4">
                    <div class="card-header fw-bold">Services and Parts</div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="repair.line_ids" t-as="line">
                                    <td t-out="line.name"/>
                                    <td class="text-end" t-out="line.quantity"/>
                                    <td class="text-end"><span t-field="line.unit_price"/></td>
                                    <td class="text-end fw-bold"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header fw-bold">Payment Summary</div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2"><span>Quotation Total</span><strong t-field="repair.amount_total"/></div>
                                <div class="d-flex justify-content-between mb-2"><span>Amount Paid</span><strong class="text-success" t-field="repair.amount_paid"/></div>
                                <hr/>
                                <div class="d-flex justify-content-between fs-5"><span>Amount Due</span><strong class="text-danger" t-field="repair.amount_due"/></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header fw-bold">Warranty</div>
                            <div class="card-body">
                                <p><strong>Warranty Days:</strong> <span t-field="repair.warranty_days"/></p>
                                <p class="mb-0"><strong>Warranty Expiry:</strong> <span t-out="repair.warranty_expiry or '-'"/></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
